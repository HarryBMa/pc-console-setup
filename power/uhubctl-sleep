#!/bin/bash
# Power-cycle the controller dongle ports on the way into sleep.
#
# Install to /usr/lib/systemd/system-sleep/uhubctl-sleep, chmod 755.
# systemd runs everything in that directory with two arguments:
#
#   $1  pre | post
#   $2  suspend | hibernate | hybrid-sleep | suspend-then-hibernate
#
# Cycle, not off. Cutting the port and leaving it dead would save controller
# battery but kill wake-on-controller with it — a console you cannot wake from
# the sofa. A cycle drops the link, which is what makes an 8BitDo switch itself
# off, and then the port comes back up. So the controllers sleep, the dongles
# stay live, and pressing a button still wakes the box.
#
# There is nothing to do on resume, for the same reason: the ports were never
# left off.
#
# Set HUB to the location from `sudo uhubctl` — the string after
# "Current status for hub", e.g. 1-2 or 3-1.4. PORTS is the comma-separated
# port list the dongles are in. Both are hardware-specific; there is no sensible
# default, so this exits rather than guessing and cycling the wrong thing.

set -u

HUB="${UHUBCTL_HUB:-}"      # TODO: set, e.g. HUB=1-2
PORTS="${UHUBCTL_PORTS:-}"  # TODO: set, e.g. PORTS=1,2,3,4

# Seconds the port stays dark during the cycle. Long enough for the controller
# to notice the link is gone; uhubctl's own default is 2.
DELAY="${UHUBCTL_DELAY:-2}"

action="${1:-}"
target="${2:-}"

log() { logger -t uhubctl-sleep "$*"; }

if [ -z "$HUB" ] || [ -z "$PORTS" ]; then
    log "HUB/PORTS not set, doing nothing (see the comment in this file)"
    exit 0
fi

if ! command -v uhubctl >/dev/null 2>&1; then
    log "uhubctl not installed, doing nothing"
    exit 0
fi

# systemd waits for this script before suspending, so the cycle finishes first.
if [ "$action" = "pre" ]; then
    log "cycling hub $HUB ports $PORTS before $target"
    uhubctl -l "$HUB" -p "$PORTS" -a cycle -d "$DELAY" || log "uhubctl cycle failed"
fi

exit 0
